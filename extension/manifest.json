{
  "manifest_version": 3,
  "name": "OpenCode Sidebar",
  "version": "0.1.0",
  "description": "OpenCode's local web UI with tools to list Chrome tabs and read their content.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["session.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open OpenCode sidebar"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src http://127.0.0.1:* http://localhost:*; connect-src 'self' http: https: blob: file:; worker-src 'self'; style-src 'self'"
  },
  "key": ""
}
